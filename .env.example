# Copie para .env e preencha. O .env nunca vai pro git.
# Gere segredos com: openssl rand -hex 32

# Chave que os apps usam pra falar com o gateway (formato sk-...)
LITELLM_MASTER_KEY=sk-troque-isto

# Token entre gateway e pod (use só letras/números — vai num header HTTP)
POD_TOKEN=troque-isto

# Onde o gateway encontra o pod.
#   local:  http://pod:8080/v1  (padrão do docker compose)
#   RunPod: https://<pod-id>-8080.proxy.runpod.net/v1
POD_URL=http://pod:8080/v1

# Perfil de modelos do pod: dev | 16gb | 24gb | 32gb
PERFIL=dev

# Pra scripts/pod.sh (RunPod > Settings > API Keys; o ID aparece no card do pod)
RUNPOD_API_KEY=
RUNPOD_POD_ID=

# Pra scripts/testar.sh e benchmark.py (padrão: http://localhost:4000)
GATEWAY_URL=http://localhost:4000
